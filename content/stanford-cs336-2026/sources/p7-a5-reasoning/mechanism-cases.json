          0.98,
          -0.42,
          0.42,
          -0.98
        ],
        "ascent_objectives": [
          0.84,
          -0.56,
          0.42,
          -0.98
        ],
        "clipped_branch_active": [
          true,
          true,
          false,
          false
        ]
      }
    },
    {
