  "cases": [
    {
      "id": "shifted-label-mask",
      "check_kind": "sequence_alignment",
      "body_section": "3.2",
      "inputs": {
        "prompt_ids": [
          11,
          12,
          13
        ],
        "response_ids": [
          21,
          22
        ]
      },
      "definition": "Concatenated token sequence; inputs omit final token, labels omit first; mask classifies origin of each label.",
      "expected": {
        "input_ids": [
          11,
          12,
          13,
          21
        ],
        "labels": [
          12,
          13,
          21,
          22
        ],
        "response_mask": [
          0,
          0,
          1,
          1
        ]
      }
    },
    {
      "id": "entropy-versus-surprisal",
      "check_kind": "categorical_entropy",
      "body_section": "3.3",
      "inputs": {
        "probabilities": [
          0.5,
          0.25,
          0.25
        ],
        "selected_index": 0
      },
      "definition": "Natural-log entropy −sum(p ln p); surprisal −ln(selected probability).",
      "expected": {
        "entropy_nats": 1.0397207708399179,
        "selected_surprisal_nats": 0.6931471805599453
      }
    },
    {
      "id": "reduction-and-microbatch-weights",
      "check_kind": "masked_reduction_and_accumulation",
      "body_section": "4.3 and 5.2",
      "inputs": {
        "sequence_values": [
          [
            2,
            4
          ],
          [
            1,
            1,
            3,
            3
          ],
          [
            -2
          ]
        ],
        "fixed_Z": 14,
        "microbatch_sequence_indices": [
          [
            0,
            1
          ],
          [
            2
          ]
        ]
      },
      "definition": "Sequence reducer is mean of sequence means; constant reducer is all sums/Z; microbatch sequence means weighted by original sequence counts.",
      "expected": {
        "sequence_means": [
          3,
          2,
          -2
        ],
        "sequence_reduction": 1,
        "total_sum": 12,
        "constant_reduction": 0.8571428571428571,
        "microbatch_means": [
          2.5,
          -2
        ],
        "weighted_microbatch_mean": 1,
        "incorrect_equal_microbatch_mean": 0.25
      }
    },
    {
      "id": "zero-contribution-pruning",
      "check_kind": "constant_pruning",
      "body_section": "5.3",
      "inputs": {
        "sequence_contributions": [
          3,
          0,
          7,
          0,
          0
        ],
        "fixed_Z": 20
      },
      "definition": "Removing exactly zero summands preserves sum/Z; changing denominator to survivor count changes objective.",
      "expected": {
        "original": 0.5,
        "pruned_preserving_Z": 0.5,
        "incorrect_survivor_mean": 5
      }
    },
    {
      "id": "optimizer-clock",
      "check_kind": "update_count",
      "body_section": "5.1",
      "inputs": {
        "rollout_responses": 30,
        "partitions": 6,
        "onpolicy_update_after_all": true
      },
      "definition": "One update after six accumulated microbatches versus one update per each of six train batches. The latter has five post-first-update stale steps.",
      "expected": {
        "onpolicy_updates": 1,
        "offpolicy_updates": 6,
        "offpolicy_post_first_stale_updates": 5
      }
    },
    {
      "id": "signed-clipping",
      "check_kind": "ppo_clipped_surrogate",
      "body_section": "6.3",
      "inputs": {
        "epsilon": 0.2,
